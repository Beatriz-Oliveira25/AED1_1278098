#include <stdio.h>


int main(){
    int c;
    char string[1000];
    //se o dado digitado for 0, o programa não lerá mais expressões e terminará o programa
    while(fgets(string, 1000, stdin) != NULL){
        int abertos = 0, fechados = 0;
        
        for(c=0; c<1000 && string[c]!='\0'; c++){
            if(string[c]=='('){
                abertos++;
            }
            else if (string[c]==')'){
                fechados++;
            }
            if(fechados>abertos){
                break;
            }
        }
        if(abertos==fechados){
            printf("correct\n");
        }
        else{
            printf("incorrect\n");
        }
        string[0]='\0';
    }

    return 0;
}
